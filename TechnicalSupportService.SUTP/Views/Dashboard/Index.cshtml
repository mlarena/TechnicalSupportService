@model TechnicalSupportService.Core.DTOs.DashboardDto
@using TechnicalSupportService.Core.Enums
@using TechnicalSupportService.Core.Helpers
@{ ViewData["Title"] = "Дашборд"; }

<h2>Дашборд</h2>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card stat-card rounded-3">
            <div class="card-body text-center py-3">
                <div class="text-muted small mb-1">Новые</div>
                <div class="fs-3 fw-bold text-dark">@(Model.TicketsByStatus.GetValueOrDefault("New", 0))</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card rounded-3">
            <div class="card-body text-center py-3">
                <div class="text-muted small mb-1">В работе</div>
                <div class="fs-3 fw-bold text-dark">@(Model.TicketsByStatus.GetValueOrDefault("InProgress", 0))</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card rounded-3">
            <div class="card-body text-center py-3">
                <div class="text-muted small mb-1">Решены</div>
                <div class="fs-3 fw-bold text-dark">@(Model.TicketsByStatus.GetValueOrDefault("Resolved", 0))</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card rounded-3">
            <div class="card-body text-center py-3">
                <div class="text-muted small mb-1">Критические</div>
                <div class="fs-3 fw-bold text-dark">@Model.CriticalCount</div>
            </div>
        </div>
    </div>
</div>

<h4>Последние заявки</h4>
<table class="table table-hover">
    <thead><tr><th>Номер</th><th>Заголовок</th><th>Статус</th><th>Приоритет</th><th>Исполнитель</th><th>Продукт</th><th>Дата</th></tr></thead>
    <tbody>
    @foreach (var t in Model.RecentTickets)
    {
        <tr onclick="location.href='@Url.Action("Details", "Tickets", new { id = t.Id })'" style="cursor:pointer">
            <td>@t.Number</td><td>@t.Title</td>
            <td><span class="badge bg-@(t.Status == TicketStatus.New ? "info" : t.Status == TicketStatus.InProgress ? "warning" : t.Status == TicketStatus.Resolved ? "success" : "secondary")">@t.Status.ToDisplayString()</span></td>
            <td><span class="badge bg-@(t.Priority == Priority.Critical ? "danger" : t.Priority == Priority.High ? "warning" : "info")">@t.Priority.ToDisplayString()</span></td>
            <td>@(t.AssignedToUserName ?? "—")</td>
            <td>@t.ProductName</td><td>@t.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
        </tr>
    }
    </tbody>
</table>
