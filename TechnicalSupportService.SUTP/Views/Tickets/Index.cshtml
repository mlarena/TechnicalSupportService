@model TechnicalSupportService.Core.DTOs.PagedResult<TechnicalSupportService.Core.DTOs.TicketListItemDto>
@using TechnicalSupportService.Core.DTOs
@using TechnicalSupportService.Core.Enums
@using TechnicalSupportService.Core.Helpers
@{ ViewData["Title"] = "Заявки"; var filter = ViewBag.Filter as TicketFilterDto ?? new TicketFilterDto(); }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Заявки</h2>
    <a asp-action="Create" class="btn btn-primary">+ Создать заявку</a>
</div>

<div class="card mb-4"><div class="card-body">
    <div class="row g-2">
        <div class="col-md-2">
            <select id="filterStatus" class="form-select form-select-sm" onchange="filterTickets()">
                <option value="">Все статусы</option>
                @foreach (var s in Enum.GetValues<TicketStatus>())
                { <option value="@s" selected="@(filter.Status == s)">@s.ToDisplayString()</option> }
            </select>
        </div>
        <div class="col-md-2">
            <select id="filterPriority" class="form-select form-select-sm" onchange="filterTickets()">
                <option value="">Все приоритеты</option>
                @foreach (var p in Enum.GetValues<Priority>())
                { <option value="@p" selected="@(filter.Priority == p)">@p.ToDisplayString()</option> }
            </select>
        </div>
        <div class="col-md-4">
            <input type="text" id="filterSearch" class="form-control form-control-sm" placeholder="Поиск..." value="@filter.Search" onkeyup="if(event.key==='Enter')filterTickets()" />
        </div>
        <div class="col-md-2">
            <button type="button" class="btn btn-outline-primary btn-sm w-100" onclick="filterTickets()">Найти</button>
        </div>
    </div>
</div></div>

<table class="table table-hover">
    <thead><tr><th>Номер</th><th>Заголовок</th><th>Статус</th><th>Приоритет</th><th>Продукт</th><th>Исполнитель</th><th>Дата</th></tr></thead>
    <tbody id="ticketsBody">
    @foreach (var t in Model.Items)
    {
        <tr onclick="location.href='@Url.Action("Details", new { id = t.Id })'" style="cursor:pointer">
            <td>@t.Number</td><td>@t.Title</td>
            <td><span class="badge bg-@(t.Status == TicketStatus.New ? "info" : t.Status == TicketStatus.InProgress ? "warning" : t.Status == TicketStatus.Resolved ? "success" : "secondary")">@t.Status.ToDisplayString()</span></td>
            <td><span class="badge bg-@(t.Priority == Priority.Critical ? "danger" : t.Priority == Priority.High ? "warning" : "info")">@t.Priority.ToDisplayString()</span></td>
            <td>@t.ProductName</td><td>@(t.AssignedToUserName ?? "—")</td><td>@t.CreatedAt.ToString("dd.MM.yyyy")</td>
        </tr>
    }
    </tbody>
</table>

<nav id="paginationNav" style="@(Model.TotalPages > 1 ? "" : "display:none")">
    <ul class="pagination justify-content-center" id="paginationList">
        @for (int i = 1; i <= Model.TotalPages; i++)
        { <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" href="#" onclick="filterTickets(@i);return false;">@i</a></li> }
    </ul>
</nav>

@section Scripts {
<script>
const detailsUrl = '@Url.Action("Details")';
const apiUrl = '@Url.Action("GetFilteredTickets")';

function statusBadgeClass(status) {
    switch (status) {
        case 'New': return 'bg-info';
        case 'InProgress': return 'bg-warning';
        case 'Resolved': return 'bg-success';
        case 'Reopened': return 'bg-danger';
        case 'Assigned': return 'bg-primary';
        default: return 'bg-secondary';
    }
}

function priorityBadgeClass(priority) {
    switch (priority) {
        case 'Critical': return 'bg-danger';
        case 'High': return 'bg-warning';
        case 'Medium': return 'bg-info';
        default: return 'bg-secondary';
    }
}

function filterTickets(page) {
    const status = document.getElementById('filterStatus').value;
    const priority = document.getElementById('filterPriority').value;
    const search = document.getElementById('filterSearch').value;

    const params = new URLSearchParams();
    if (status) params.set('status', status);
    if (priority) params.set('priority', priority);
    if (search) params.set('search', search);
    params.set('page', page || 1);
    params.set('pageSize', 20);

    fetch(apiUrl + '?' + params.toString())
        .then(r => r.json())
        .then(data => {
            const tbody = document.getElementById('ticketsBody');
            tbody.innerHTML = '';

            if (data.items.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">Заявки не найдены</td></tr>';
            } else {
                data.items.forEach(t => {
                    const tr = document.createElement('tr');
                    tr.style.cursor = 'pointer';
                    tr.onclick = () => location.href = detailsUrl + '/' + t.id;
                    tr.innerHTML =
                        '<td>' + t.number + '</td>' +
                        '<td>' + t.title + '</td>' +
                        '<td><span class="badge ' + statusBadgeClass(t.status) + '">' + t.statusDisplay + '</span></td>' +
                        '<td><span class="badge ' + priorityBadgeClass(t.priority) + '">' + t.priorityDisplay + '</span></td>' +
                        '<td>' + t.productName + '</td>' +
                        '<td>' + (t.assignedToUserName || '—') + '</td>' +
                        '<td>' + t.createdAt + '</td>';
                    tbody.appendChild(tr);
                });
            }

            // Pagination
            const nav = document.getElementById('paginationNav');
            const list = document.getElementById('paginationList');
            list.innerHTML = '';
            if (data.totalPages > 1) {
                nav.style.display = '';
                for (let i = 1; i <= data.totalPages; i++) {
                    const li = document.createElement('li');
                    li.className = 'page-item' + (i === data.page ? ' active' : '');
                    const a = document.createElement('a');
                    a.className = 'page-link';
                    a.href = '#';
                    a.textContent = i;
                    a.onclick = (e) => { e.preventDefault(); filterTickets(i); };
                    li.appendChild(a);
                    list.appendChild(li);
                }
            } else {
                nav.style.display = 'none';
            }
        })
        .catch(err => console.error('Ошибка фильтрации:', err));
}
</script>
}
