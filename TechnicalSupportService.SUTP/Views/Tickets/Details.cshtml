@model TechnicalSupportService.Core.DTOs.TicketDto
@using TechnicalSupportService.Core.DTOs
@using TechnicalSupportService.Core.Enums
@using TechnicalSupportService.Core.Constants
@using TechnicalSupportService.Core.Helpers
@using Microsoft.AspNetCore.Mvc.Rendering
@{ ViewData["Title"] = $"Заявка {Model.Number}";
    var comments = ViewBag.Comments as List<CommentDto> ?? new();
    var attachments = ViewBag.Attachments as List<AttachmentDto> ?? new();
    var history = ViewBag.History as List<TicketHistoryDto> ?? new();
    var currentRole = ViewBag.CurrentRole as string ?? "";
    var currentUserId = (Guid)ViewBag.CurrentUserId;
    var engineers = ViewBag.Engineers as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>());
    var validStatuses = ViewBag.ValidStatuses as List<TicketStatus> ?? new();
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h2>@Model.Number — @Model.Title</h2>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        @* === Смена статуса === *@
        @if (validStatuses.Any())
        {
            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#statusModal">
                <i class="bi bi-arrow-repeat"></i> Сменить статус
            </button>
        }

        @* === Назначение исполнителя (Admin/Manager) === *@
        @if (currentRole == Roles.Admin || currentRole == Roles.Manager)
        {
            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#assignModal">
                <i class="bi bi-person-plus"></i> Назначить исполнителя
            </button>
        }

        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">Редактировать</a>

        @if (currentRole == Roles.Admin)
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Удалить заявку?')">
                <button type="submit" class="btn btn-danger btn-sm">Удалить</button>
            </form>
        }
    </div>
</div>

<ul class="nav nav-tabs" id="ticketTabs">
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#info">Информация</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#files">Файлы (@attachments.Count)</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#comments">Комментарии (@comments.Count)</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#history">История</a></li>
</ul>

<div class="tab-content mt-3">
    <div class="tab-pane fade" id="info">
        <div class="row"><div class="col-md-6"><dl class="row">
            <dt class="col-sm-4">Статус</dt><dd class="col-sm-8"><span class="badge bg-@(Model.Status == TicketStatus.New ? "info" : Model.Status == TicketStatus.InProgress ? "warning" : Model.Status == TicketStatus.Resolved ? "success" : Model.Status == TicketStatus.Reopened ? "danger" : "secondary")">@Model.Status.ToDisplayString()</span></dd>
            <dt class="col-sm-4">Приоритет</dt><dd class="col-sm-8"><span class="badge bg-@(Model.Priority == Priority.Critical ? "danger" : Model.Priority == Priority.High ? "warning" : Model.Priority == Priority.Medium ? "info" : "secondary")">@Model.Priority.ToDisplayString()</span></dd>
            <dt class="col-sm-4">Продукт</dt><dd class="col-sm-8">@Model.ProductName (@(((ProductType)Enum.Parse(typeof(ProductType), Model.ProductType)).ToDisplayString()))</dd>
            <dt class="col-sm-4">Версия</dt><dd class="col-sm-8">@(Model.Version ?? "—")</dd>
            <dt class="col-sm-4">Категория</dt><dd class="col-sm-8">@Model.Category.ToDisplayString()</dd>
            <dt class="col-sm-4">Источник</dt><dd class="col-sm-8">@Model.Source.ToDisplayString()</dd>
            @if (Model.Impact.HasValue) { <dt class="col-sm-4">Влияние</dt><dd class="col-sm-8">@Model.Impact.Value.ToDisplayString()</dd> }
        </dl></div><div class="col-md-6"><dl class="row">
            <dt class="col-sm-4">Создал</dt><dd class="col-sm-8">@Model.CreatedByUserName (@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm"))</dd>
            <dt class="col-sm-4">Исполнитель</dt><dd class="col-sm-8">@(Model.AssignedToUserName ?? "Не назначен")</dd>
            <dt class="col-sm-4">Обновлена</dt><dd class="col-sm-8">@Model.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
            @if (Model.ClosedAt.HasValue) { <dt class="col-sm-4">Закрыта</dt><dd class="col-sm-8">@Model.ClosedAt.Value.ToString("dd.MM.yyyy HH:mm")</dd> }
            @if (!string.IsNullOrWhiteSpace(Model.Resolution)) { <dt class="col-sm-4">Решение</dt><dd class="col-sm-8">@Model.Resolution</dd> }
        </dl></div></div>
        <h5>Описание</h5><p style="white-space:pre-wrap">@Model.Description</p>
    </div>

    <div class="tab-pane fade" id="files">
        <form asp-controller="Files" asp-action="Upload" method="post" enctype="multipart/form-data" class="mb-3">
            <input type="hidden" name="ticketId" value="@Model.Id" />
            <div class="input-group"><input type="file" name="file" class="form-control" required /><button type="submit" class="btn btn-outline-primary">Загрузить</button></div>
        </form>
        @foreach (var f in attachments)
        { <div class="d-flex justify-content-between align-items-center border-bottom py-2">
            <div><strong>@f.FileName</strong> <small class="text-muted">(@($"{f.FileSizeBytes / 1024.0:F1}") КБ, @f.UploadedByName)</small></div>
            <div>
                <a asp-controller="Files" asp-action="Download" asp-route-id="@f.Id" class="btn btn-sm btn-outline-success">Скачать</a>
                <form asp-controller="Files" asp-action="Delete" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@f.Id" /><input type="hidden" name="ticketId" value="@Model.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                </form>
            </div>
          </div> }
    </div>

    <div class="tab-pane fade" id="comments">
        <form asp-action="AddComment" asp-route-id="@Model.Id" method="post" class="mb-4">
            <div class="mb-2"><textarea name="Content" class="form-control" rows="3" placeholder="Комментарий..." required></textarea></div>
            @if (currentRole != Roles.Applicant) { <div class="form-check mb-2"><input type="checkbox" name="IsInternal" value="true" class="form-check-input" id="intCheck" /><label class="form-check-label" for="intCheck">Внутренний</label></div> }
            <button type="submit" class="btn btn-primary btn-sm">Отправить</button>
        </form>
        @foreach (var c in comments)
        { <div class="border-start border-3 @(c.IsInternal ? "border-warning" : "border-primary") ps-3 mb-3">
            <div class="d-flex justify-content-between"><strong>@c.AuthorName</strong><small class="text-muted">@c.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small></div>
            @if (c.IsInternal) { <span class="badge bg-warning text-dark">Внутренний</span> }
            <p class="mb-0" style="white-space:pre-wrap">@c.Content</p>
          </div> }
    </div>

    <div class="tab-pane fade" id="history">
        @foreach (var h in history)
        { <div class="d-flex mb-2">
            <small class="text-muted me-3" style="min-width:140px">@h.ChangedAt.ToString("dd.MM.yyyy HH:mm")</small>
            <div><strong>@h.ChangedByName</strong> <span class="badge bg-secondary">@h.ChangeType.ToDisplayString()</span>
            @if (!string.IsNullOrWhiteSpace(h.FieldName)) { <span>@h.FieldName: @(h.OldValue ?? "—") → @(h.NewValue ?? "—")</span> } else { <span>@h.NewValue</span> }
            </div>
          </div> }
    </div>
</div>

@* === Модальное окно смены статуса === *@
@if (validStatuses.Any())
{
<div class="modal fade" id="statusModal" tabindex="-1" aria-labelledby="statusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="statusModalLabel">Смена статуса заявки</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">Текущий статус: <span class="badge bg-@(Model.Status == TicketStatus.New ? "info" : Model.Status == TicketStatus.InProgress ? "warning" : Model.Status == TicketStatus.Resolved ? "success" : Model.Status == TicketStatus.Reopened ? "danger" : "secondary") fs-6">@Model.Status.ToDisplayString()</span></p>
                <p class="text-muted mb-3">Выберите новый статус:</p>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var s in validStatuses)
                    {
                        var btnClass = s == TicketStatus.New ? "btn-info"
                            : s == TicketStatus.InProgress ? "btn-warning"
                            : s == TicketStatus.Resolved ? "btn-success"
                            : s == TicketStatus.Reopened ? "btn-danger"
                            : s == TicketStatus.Closed ? "btn-dark"
                            : "btn-secondary";
                        <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post" class="d-inline">
                            <input type="hidden" name="newStatus" value="@s" />
                            <button type="submit" class="btn @btnClass">
                                @s.ToDisplayString()
                            </button>
                        </form>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
            </div>
        </div>
    </div>
</div>
}

@* === Модальное окно назначения исполнителя === *@
@if (currentRole == Roles.Admin || currentRole == Roles.Manager)
{
<div class="modal fade" id="assignModal" tabindex="-1" aria-labelledby="assignModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="assignModalLabel">Назначение исполнителя</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">Текущий исполнитель: <strong>@(Model.AssignedToUserName ?? "Не назначен")</strong></p>
                <p class="text-muted mb-3">Выберите исполнителя:</p>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var item in engineers)
                    {
                        var isCurrent = item.Value == Model.AssignedToUserId?.ToString();
                        <form asp-action="Assign" asp-route-id="@Model.Id" method="post" class="d-inline">
                            <input type="hidden" name="assigneeId" value="@item.Value" />
                            <button type="submit" class="btn @(isCurrent ? "btn-primary" : "btn-outline-primary")">
                                @if (isCurrent) { <i class="bi bi-check-lg"></i> } @item.Text
                            </button>
                        </form>
                    }
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <form asp-action="Assign" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <input type="hidden" name="assigneeId" value="" />
                    <button type="submit" class="btn btn-outline-danger">Снять исполнителя</button>
                </form>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
            </div>
        </div>
    </div>
</div>
}

@section Scripts {
<script>
    (function() {
        var tab = new URLSearchParams(window.location.search).get('tab');
        var tabMap = { 'files': '#files', 'comments': '#comments', 'history': '#history' };
        var target = tabMap[tab] || '#info';
        var tabEl = document.querySelector('#ticketTabs a[href="' + target + '"]');
        if (tabEl) new bootstrap.Tab(tabEl).show();
    })();
</script>
}
