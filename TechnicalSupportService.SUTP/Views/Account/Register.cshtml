@{ ViewData["Title"] = "Регистрация"; }
<div class="row justify-content-center"><div class="col-md-6"><div class="card shadow"><div class="card-body">
<h3 class="card-title text-center mb-4">Регистрация</h3>
<div asp-validation-summary="All" class="text-danger mb-3"></div>
<form asp-action="Register" method="post">
    <div class="mb-3"><label class="form-label">ФИО *</label><input type="text" name="fullName" class="form-control" required /></div>
    <div class="mb-3"><label class="form-label">Email *</label><input type="email" name="email" class="form-control" required /></div>
    <div class="mb-3"><label class="form-label">Пароль *</label><input type="password" name="password" class="form-control" required minlength="8" /></div>
    <div class="mb-3"><label class="form-label">Подтверждение пароля *</label><input type="password" name="confirmPassword" class="form-control" required /></div>
    <button type="submit" class="btn btn-primary w-100">Зарегистрироваться</button>
</form>
<div class="text-center mt-3"><a asp-action="Login">Уже есть аккаунт? Войти</a></div>
</div></div></div></div>
