@{ ViewData["Title"] = "Смена пароля"; }
<h2>Смена пароля</h2>
<div asp-validation-summary="All" class="text-danger"></div>
@if (ViewBag.Message != null) { <div class="alert alert-success">@ViewBag.Message</div> }
<div class="row"><div class="col-md-6">
<form asp-action="ChangePassword" method="post">
    <div class="mb-3"><label class="form-label">Текущий пароль</label><input type="password" name="currentPassword" class="form-control" required /></div>
    <div class="mb-3"><label class="form-label">Новый пароль</label><input type="password" name="newPassword" class="form-control" required minlength="8" /></div>
    <div class="mb-3"><label class="form-label">Подтверждение</label><input type="password" name="confirmPassword" class="form-control" required /></div>
    <button type="submit" class="btn btn-primary">Изменить пароль</button>
</form>
</div></div>
