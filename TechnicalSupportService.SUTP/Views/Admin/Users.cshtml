@model TechnicalSupportService.Core.DTOs.PagedResult<TechnicalSupportService.Core.DTOs.UserDto>
@using TechnicalSupportService.Core.Helpers
@{ ViewData["Title"] = "Пользователи"; var filter = ViewBag.Filter as TechnicalSupportService.Core.DTOs.UserFilterDto ?? new(); }
<h2>Пользователи</h2>
<a asp-action="CreateUser" class="btn btn-primary mb-3">+ Добавить</a>
<form method="get" class="mb-3"><div class="row g-2">
    <div class="col-md-4"><input type="text" name="Search" class="form-control form-control-sm" placeholder="Поиск..." value="@filter.Search" /></div>
    <div class="col-md-2"><button type="submit" class="btn btn-outline-primary btn-sm">Найти</button></div>
</div></form>
<table class="table table-hover">
    <thead><tr><th>ФИО</th><th>Email</th><th>Роль</th><th>Статус</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model.Items)
    { <tr>
        <td>@u.FullName</td><td>@u.Email</td><td>@EnumDisplayHelper.RoleToDisplayString(u.Role)</td>
        <td>@(u.IsActive ? "✅ Активен" : "🔒 Заблокирован")</td>
        <td>
            <a asp-action="EditUser" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Редактировать</a>
            <form asp-action="BlockUser" method="post" class="d-inline">
                <input type="hidden" name="id" value="@u.Id" /><input type="hidden" name="block" value="@u.IsActive" />
                <button type="submit" class="btn btn-sm btn-outline-@(u.IsActive ? "warning" : "success")">@(u.IsActive ? "Заблокировать" : "Разблокировать")</button>
            </form>
        </td>
      </tr> }
    </tbody>
</table>
