@model TechnicalSupportService.Core.DTOs.UserDto
@{ ViewData["Title"] = "Редактировать пользователя"; }
<h2>Редактировать: @Model.FullName</h2>
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="EditUser" asp-route-id="@Model.Id" method="post">
    <div class="mb-3"><label class="form-label">ФИО *</label><input name="FullName" class="form-control" value="@Model.FullName" required /></div>
    <div class="mb-3"><label class="form-label">Должность</label><input name="Position" class="form-control" value="@Model.Position" /></div>
    <div class="mb-3"><label class="form-label">Роль *</label><select name="Role" class="form-select" required>
        @foreach (var r in ViewBag.Roles as string[]) { <option value="@r" selected="@(r == Model.Role)">@r</option> }
    </select></div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-action="Users" class="btn btn-outline-secondary">Отмена</a>
</form>
